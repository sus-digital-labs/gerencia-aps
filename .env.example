# Valores VITE_* são públicos e incorporados ao bundle do navegador.
# NUNCA insira senhas, tokens reais de produção ou IPs privados aqui.

VITE_APP_ID=sus-analytics-local
VITE_OAUTH_PORTAL_URL=http://localhost:4000/auth
VITE_FRONTEND_FORGE_API_URL=http://localhost:4000/maps
VITE_FRONTEND_FORGE_API_KEY=dev-only-public-key
VITE_API_URL=http://localhost:3000/api/trpc
VITE_DEMO_MODE=true

# Configurações Territoriais de Exemplo
VITE_MUNICIPALITY_IBGE=0000000
VITE_MUNICIPALITY_NAME=Cidade Modelo
VITE_MUNICIPALITY_UF=UF
VITE_MAP_CENTER_LAT=-15.7801
VITE_MAP_CENTER_LNG=-47.9292
VITE_MAP_DEFAULT_ZOOM=12
